// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  
  email     String    @unique
  password  String

  name      String?
  role      Role      @default(USER)
  createdAt DateTime  @default(now())

  orders    Order[]
}

enum Role {
  USER
  ADMIN
}

model Order {
  id              String           @id @default(uuid())
  userId          Int?
  customerName    String
  customerEmail   String?
  customerPhone   String
  fulfillment     FulfillmentType  @default(PICKUP)
  paymentMethod   PaymentMethod    @default(UPI_GPAY)
  status          OrderStatus      @default(RECEIVED)
  subtotal        Int
  gst             Int
  tip             Int              @default(0)
  deliveryFee     Int              @default(0)
  total           Int
  notes           String?
  etaMinutes      Int              @default(18)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User?            @relation(fields: [userId], references: [id])
  items           OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     String
  menuItemId  String
  name        String
  quantity    Int
  unitPrice   Int
  modifiers   Json?
  lineTotal   Int

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum OrderStatus {
  RECEIVED
  QUEUED
  PREPARING
  READY
  COMPLETED
  FAILED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  UPI_GPAY
  UPI_PHONEPE
  UPI_PAYTM
  CARD
  CASH_AT_COUNTER
}
