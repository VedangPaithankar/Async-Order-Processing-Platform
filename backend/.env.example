PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/brewflow
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Local Docker Redis can use host/port.
REDIS_HOST=localhost
REDIS_PORT=6379

# Cloud Redis providers usually provide one URL. If present, REDIS_URL wins.
REDIS_URL=

# Set to "true" only when running the API without a separate worker process
# (e.g. Render's free tier, which has no free plan for background workers).
# Leave unset for local docker-compose, where "worker" runs as its own container.
RUN_WORKER_INLINE=
